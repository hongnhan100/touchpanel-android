<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SauterTouchpanel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Ẩn ActionBar và thiết lập Fullscreen -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/sauter_dark</item>
        <item name="android:navigationBarColor">@color/sauter_dark</item>
    </style>
</resources>
